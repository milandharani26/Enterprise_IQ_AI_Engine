            <td>450</td>
        </tr>
    </tbody>
</table>

<h2>🗄️ Table 3: connectors.schema_columns</h2>
<p>Stores metadata columns belonging to the tables.</p>
<table>
    <thead>
        <tr>
            <th>id (UUID)</th>
            <th>table_id</th>
            <th>column_name</th>
            <th>data_type</th>
            <th>is_nullable</th>
            <th>is_primary_key</th>
            <th>default_value</th>
            <th>column_description</th>
            <th>ordinal_position</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="code">e5e5e5e5-e5e5-...</span></td>
            <td><span class="code">a1a1...</span> (users)</td>
            <td>id</td>
            <td>integer</td>
            <td>false</td>
            <td>true</td>
            <td>nextval(...)</td>
            <td>Unique primary key</td>
            <td>1</td>
        </tr>
        <tr>
            <td><span class="code">f6f6f6f6-f6f6-...</span></td>
            <td><span class="code">a1a1...</span> (users)</td>
