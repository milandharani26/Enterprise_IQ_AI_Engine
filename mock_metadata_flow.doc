            <td>varchar</td>
            <td>false</td>
            <td>false</td>
            <td>null</td>
            <td>Used for user authentication</td>
            <td>2</td>
        </tr>
        <tr>
            <td><span class="code">g7g7g7g7-g7g7-...</span></td>
            <td><span class="code">b2b2...</span> (orders)</td>
            <td>id</td>
            <td>integer</td>
            <td>false</td>
            <td>true</td>
            <td>nextval(...)</td>
            <td>Transaction order ID</td>
            <td>1</td>
        </tr>
        <tr>
            <td><span class="code">h8h8h8h8-h8h8-...</span></td>
            <td><span class="code">b2b2...</span> (orders)</td>
            <td>user_id</td>
            <td>integer</td>
            <td>false</td>
            <td>false</td>
            <td>null</td>
            <td>References users(id)</td>
            <td>2</td>
        </tr>
        <tr>
            <td><span class="code">i9i9i9i9-i9i9-...</span></td>
            <td><span class="code">d4d4...</span> (employees)</td>
            <td>id</td>
            <td>integer</td>
            <td>false</td>
            <td>true</td>
            <td>null</td>
            <td>Unique employee number</td>
            <td>1</td>
        </tr>
        <tr>
            <td><span class="code">j0j0j0j0-j0j0-...</span></td>
            <td><span class="code">d4d4...</span> (employees)</td>
            <td>salary</td>
            <td>decimal</td>
            <td>true</td>
            <td>false</td>
            <td>null</td>
            <td>Restricted payroll column</td>
            <td>2</td>
        </tr>
    </tbody>
</table>

<h2>🗄️ Table 4: connectors.schema_relationships</h2>
<p>Stores foreign keys to aid AI in building JOIN queries.</p>
<table>
    <thead>
        <tr>
            <th>id (UUID)</th>
            <th>organization_id</th>
            <th>database_connection_id</th>
            <th>source_table</th>
            <th>source_column</th>
            <th>target_table</th>
            <th>target_column</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="code">r1r1r1r1-r1r1-...</span></td>
            <td><span class="code">11111111-1111-...</span></td>
            <td><span class="code">55555555-5555-...</span></td>
            <td>public.orders</td>
            <td>user_id</td>
            <td>public.users</td>
            <td>id</td>
        </tr>
        <tr>
            <td><span class="code">r2r2r2r2-r2r2-...</span></td>
            <td><span class="code">22222222-2222-...</span></td>
            <td><span class="code">66666666-6666-...</span></td>
            <td>company_hr.employees</td>
            <td>dept_id</td>
            <td>company_hr.departments</td>
            <td>id</td>
        </tr>
    </tbody>
</table>

<h2>🗄️ Table 5: connectors.schema_embeddings</h2>
<p>Stores generated schema summaries transformed to 1536-dimensional vectors.</p>
<table>
    <thead>
        <tr>
            <th>id (UUID)</th>
            <th>organization_id</th>
            <th>database_connection_id</th>
            <th>object_type</th>
            <th>object_name</th>
            <th>content</th>
            <th>embedding</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="code">v1v1v1v1-v1v1-...</span></td>
            <td><span class="code">11111111-1111-...</span></td>
            <td><span class="code">55555555-5555-...</span></td>
            <td>database</td>
            <td>database_summary</td>
            <td>Database containing 2 tables: public.users, public.orders.</td>
            <td><span class="code">[-0.0125, 0.0054, ... 1536 floats]</span></td>
        </tr>
        <tr>
            <td><span class="code">v2v2v2v2-v2v2-...</span></td>
            <td><span class="code">11111111-1111-...</span></td>
            <td><span class="code">55555555-5555-...</span></td>
            <td>table</td>
            <td>public.users</td>
            <td>Table public.users: Stores client profile... Columns: id, email...</td>
            <td><span class="code">[0.0210, -0.0041, ... 1536 floats]</span></td>
        </tr>
    </tbody>
</table>

<h2>🗄️ Table 6: connectors.sql_query_logs</h2>
<p>Logs queries executed by users for auditing and debugging.</p>
<table>
    <thead>
        <tr>
