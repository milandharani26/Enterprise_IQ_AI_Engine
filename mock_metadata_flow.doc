            <td>Stores internal business departments and managers</td>
            <td>15</td>
        </tr>
        <tr>
            <td><span class="code">d4d4d4d4-d4d4-d4d4-d4d4-d4d4d4d4d4d4</span></td>
            <td><span class="code">22222222-2222-...</span></td>
            <td><span class="code">66666666-6666-...</span></td>
            <td>company_hr</td>
            <td>employees</td>
